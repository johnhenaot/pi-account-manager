{
	"name": "pi-account-manager",
	"version": "0.1.0",
	"description": "Pi extension for managing multiple named OAuth accounts per provider",
	"license": "MIT",
	"author": "John Henao <johnhenaot@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/johnhenaot/pi-account-manager.git"
	},
	"keywords": [
		"pi-package"
	],
	"type": "module",
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"files": [
		"src"
	],
	"scripts": {
		"prepublishOnly": "npm run check",
		"format": "biome check --write .",
		"lint": "biome ci .",
		"typecheck": "tsc --noEmit",
		"test": "vitest --run",
		"check": "npm run lint && npm run typecheck && npm test"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-ai": {
			"optional": true
		},
		"@earendil-works/pi-coding-agent": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.7",
		"@earendil-works/pi-ai": "1.5.2",
		"@earendil-works/pi-coding-agent": "1.5.2",
		"typescript": "^5.9.3",
		"vitest": "^3.2.4"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
